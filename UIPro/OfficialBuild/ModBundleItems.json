{
    "bundles": {
        "version": 1,
        "itemsPrefix": "",
        "itemsSuffix": "",
        "items": [
            {
                "name": "340_UIProCore",
                "big": true,
                "files": [
                    {
                        "parent": "GameFilesEdited",
                        "sourceList": [
                            "*.txt"
                        ]
                    }
                ]
            },
            {
                "name": "340_UIProData1080",
                "big": true,
                "files": [
                    {
                        "parent": "GameFilesEdited",
                        "sourceList": [
                            "Data/INI/*.ini",
                            "Data/INI/MappedImages/HandCreated/*.ini",
                            "Window/*.wnd",
                            "Window/Menus/*.wnd"
                        ]
                    }
                ],
                "onPreBuild": {
                    "script": "Scripts/Python/ModifyPositions.py",
                    "kwargs": {
                        "size": 1080,
                        "scale": 0.5
                    }
                }
            },
            {
                "name": "340_UIProLanguage1080",
                "big": true,
                "files": [
                    {
                        "parent": "GameFilesEditedLanguage",
                        "sourceList": [
                            "Data/Brazilian/*.ini",
                            "Data/Chinese/*.ini",
                            "Data/English/*.ini",
                            "Data/French/*.ini",
                            "Data/German/*.ini",
                            "Data/Italian/*.ini",
                            "Data/Korean/*.ini",
                            "Data/Polish/*.ini",
                            "Data/Spanish/*.ini",
                            "Window/*.wnd",
                            "Window/Menus/*.wnd"
                        ]
                    }
                ],
                "onPreBuild": {
                    "script": "Scripts/Python/ModifyFontSizes.py",
                    "kwargs": {
                        "size": 1080,
                        "scale": 1
                    }
                }
            },
            {
                "name": "340_UIProArt1080",
                "big": true,
                "files": [
                    {
                        "parent": "GameFilesEdited",
                        "params": {
                            "rescale": 0.5,
                            "resampling": "BOX",
                            "-quality": 255,
                            "-mipmode": "None"
                        },
                        "sourceTargetList": [
                            {
                                "source": "Art/Textures/*.psd",
                                "target": "Art/Textures/*.dds"
                            }
                        ]
                    },
                    {
                        "parent": "GameFilesEdited",
                        "sourceList": [
                            "Art/Textures/BlankTexture_16.tga"
                        ]
                    }
                ]
            }
        ]
    }
